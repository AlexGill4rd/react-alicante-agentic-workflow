# Supabase QA project: Project Settings → API (or the "Connect" button).
# The publishable key is safe in the browser; row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=your-qa-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-qa-publishable-key

# Production values live in Vercel, not here. At release time you paste the
# Production project ref when the release flow asks for it.

# Server-only: read in services/news.ts, never sent to the browser.
NEWS_API_URL=https://hn.algolia.com/api/v1

# Public: the NEXT_PUBLIC_ prefix inlines it into the client bundle.
# Set to "false" to hide the Stats page and nav link.
NEXT_PUBLIC_ENABLE_STATS=true
