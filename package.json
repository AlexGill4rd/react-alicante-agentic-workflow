{
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "workshop:tickets": "node scripts/create-workshop-tickets.mjs",
    "db:link:status": "supabase projects list",
    "db:push": "supabase db push",
    "db:push:dry-run": "supabase db push --dry-run",
    "db:types": "supabase gen types --lang=typescript --linked > types/supabase.types.ts",
    "db:migration:new": "supabase migration new",
    "db:migrations:list": "supabase migration list",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "workshop:reset": "node scripts/workshop-reset.mjs",
    "prepare": "husky",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@chakra-ui/react": "3.37.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "0.511.0",
    "next": "16.3.5",
    "next-intl": "4.14.5",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "husky": "9.1.7",
    "jsdom": "30.1.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.7",
    "supabase": "2.117.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
